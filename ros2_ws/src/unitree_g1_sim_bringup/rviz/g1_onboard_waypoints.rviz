Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 38; 42; 48
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Object Search - views and decisions
      Namespaces:
        object_search: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /exploration/search_markers
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Onboard LiDAR returns
      Enabled: true
      Alpha: 0.7
      Color Transformer: AxisColor
      Position Transformer: XYZ
      Axis: Z
      Autocompute Value Bounds:
        Value: false
        Min Value: 0
        Max Value: 2.5
      Use rainbow: true
      Style: Points
      Size (Pixels): 2
      Size (m): 0.02
      Decay Time: 0.15
      Topic:
        Value: /onboard/lidar
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Observed ground scan
      Enabled: true
      Alpha: 0.7
      Color Transformer: FlatColor
      Color: 255; 220; 50
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Decay Time: 0.1
      Topic:
        Value: /scan_raw
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Online SLAM map (unknown remains unknown)
      Enabled: true
      Alpha: 0.65
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: G1
      Enabled: true
      Alpha: 1
      Collision Enabled: false
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Observed-free waypoint
      Enabled: true
      Color: 255; 80; 240
      Topic:
        Value: /benchmark/current_goal
        Depth: 1
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Validated route
      Enabled: true
      Color: 25; 220; 255
      Line Style: Lines
      Buffer Length: 1
      Pose Style: None
      Topic:
        Value: /plan
        Depth: 1
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: LiDAR tracks and predictions
      Enabled: true
      Namespaces:
        tracked_people: true
        tracked_people_predictions: true
        tracked_people_danger_corridors: false
        tracked_object_paths: false
        dynamic_obstacle_labels: true
        candidate_people: true
        candidate_people_labels: false
      Topic:
        Value: /dynamic_obstacles
        Depth: 1
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Onboard RGB camera
      Enabled: true
      Normalize Range: true
      Min Value: 0
      Max Value: 1
      Median window: 5
      Topic:
        Value: /camera/camera/color/image_raw
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Onboard depth camera
      Enabled: true
      Normalize Range: true
      Min Value: 0
      Max Value: 4000
      Median window: 5
      Topic:
        Value: /camera/camera/depth/image_rect_raw
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Decisions - green selected, blue alternatives, red rejected
      Enabled: true
      Topic:
        Value: /human_avoidance_markers
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Namespaces:
        human_aware_candidates: true
        human_aware_selected: true
        human_aware_state: true
        nearest_clear_ground_patch: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Safety decision and outgoing command
      Enabled: true
      Topic:
        Value: /navigation/command_markers
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 8
      Pitch: 1.05
      Yaw: 0.8
      Focal Point: {X: 0, Y: 0, Z: 0.5}
      Target Frame: base_footprint
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1600
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Onboard RGB camera:
    collapsed: false
  Onboard depth camera:
    collapsed: false
