diff --git a/simulate/src/dex3_hand.h b/simulate/src/dex3_hand.h
new file mode 100644
index 0000000..eb3dd72
--- /dev/null
+++ b/simulate/src/dex3_hand.h
@@ -0,0 +1,146 @@
+#pragma once
+#include <mujoco/mujoco.h>
+#include <unitree/idl/hg/HandCmd_.hpp>
+#include <unitree/idl/hg/HandState_.hpp>
+#include <unitree/robot/channel/channel_publisher.hpp>
+#include <unitree/robot/channel/channel_subscriber.hpp>
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <memory>
+#include <mutex>
+#include <string>
+
+namespace unitree_mujoco {
+// Seven independent radian channels. The 29 body actuators retain their order;
+// hand torques act only on named finger DOFs. No object attachment is involved.
+class Dex3Hands {
+  using Command = unitree_hg::msg::dds_::HandCmd_;
+  using State = unitree_hg::msg::dds_::HandState_;
+  struct Hand {
+    std::mutex mutex;
+    std::array<int,7> joint{},qpos{},dof{};
+    std::array<double,7> target{},velocity{},reference{},kp{},kd{},tau{},effort{};
+    std::chrono::steady_clock::time_point received{};
+    bool enabled = false;
+    std::shared_ptr<unitree::robot::ChannelSubscriber<Command>> subscriber;
+    std::shared_ptr<unitree::robot::ChannelPublisher<State>> publisher;
+  };
+  std::array<Hand,2> hands_;
+  const mjModel *model_ = nullptr;
+  double last_time_ = -1.,next_state_ = 0.;
+  const std::array<std::string,7> names_ = {"thumb_0","thumb_1","thumb_2","middle_0","middle_1","index_0","index_1"};
+
+  void Receive(std::size_t side,const void *message) {
+    const auto &command = *static_cast<const Command *>(message);
+    if (command.motor_cmd().size()!=7) {return;}
+    for (std::size_t i=0;i<7;++i) {
+      const auto &motor = command.motor_cmd()[i];
+      if ((motor.mode()&15)!=i || ((motor.mode()>>4)&7)!=1 ||
+          !std::isfinite(motor.q()) || !std::isfinite(motor.dq()) ||
+          !std::isfinite(motor.kp()) || !std::isfinite(motor.kd()) || !std::isfinite(motor.tau()) ||
+          motor.kp()<0 || motor.kd()<0) {return;}
+    }
+    auto &hand = hands_[side];
+    std::lock_guard<std::mutex> lock(hand.mutex);
+    for (std::size_t i=0;i<7;++i) {
+      const auto &motor = command.motor_cmd()[i];
+      hand.target[i] = motor.q();
+      hand.velocity[i] = std::clamp<double>(motor.dq(),-1.5,1.5);
+      hand.kp[i] = std::min<double>(motor.kp(),4.);
+      hand.kd[i] = std::min<double>(motor.kd(),.2);
+      hand.tau[i] = std::clamp<double>(motor.tau(),-1.4,1.4);
+    }
+    hand.received = std::chrono::steady_clock::now();
+  }
+
+  void Bind(const mjModel *model,const mjData *data) {
+    model_ = model;
+    next_state_ = 0.;
+    for (std::size_t side=0;side<2;++side) {
+      auto &hand = hands_[side];
+      const std::string prefix = side==0?"left":"right";
+      hand.enabled = true;
+      for (std::size_t i=0;i<7;++i) {
+        const int joint = mj_name2id(model,mjOBJ_JOINT,(prefix+"_hand_"+names_[i]+"_joint").c_str());
+        if (joint<0) {hand.enabled=false;break;}
+        hand.joint[i]=joint;
+        hand.qpos[i]=model->jnt_qposadr[joint];
+        hand.dof[i]=model->jnt_dofadr[joint];
+        hand.reference[i]=data->qpos[hand.qpos[i]];
+      }
+      if (!hand.enabled) {continue;}
+      {
+        std::lock_guard<std::mutex> lock(hand.mutex);
+        hand.target.fill(0.);hand.velocity.fill(0.);hand.kp.fill(2.);hand.kd.fill(.08);hand.tau.fill(0.);
+        hand.received = {};
+      }
+      if (!hand.publisher) {
+        hand.publisher=std::make_shared<unitree::robot::ChannelPublisher<State>>("rt/lf/dex3/"+prefix+"/state");
+        hand.publisher->InitChannel();
+        hand.subscriber=std::make_shared<unitree::robot::ChannelSubscriber<Command>>("rt/dex3/"+prefix+"/cmd");
+        hand.subscriber->InitChannel([this,side](const void *msg){Receive(side,msg);},1);
+      }
+    }
+  }
+
+ public:
+  void Update(const mjModel *model,mjData *data) {
+    if (model!=model_ || data->time<last_time_) {Bind(model,data);}
+    last_time_=data->time;
+    const bool publish=data->time+1e-9>=next_state_;
+    if (publish) {next_state_=data->time+.02;}
+    for (std::size_t side=0;side<2;++side) {
+      auto &hand=hands_[side];
+      if (!hand.enabled) {continue;}
+      std::array<double,7> target,velocity,kp,kd,tau;
+      bool stale;
+      {
+        std::lock_guard<std::mutex> lock(hand.mutex);
+        target=hand.target;velocity=hand.velocity;kp=hand.kp;kd=hand.kd;tau=hand.tau;
+        stale=std::chrono::duration<double>(std::chrono::steady_clock::now()-hand.received).count()>.3;
+      }
+      State state;
+      state.motor_state().resize(7);
+      state.press_sensor_state().resize(9);
+      state.error()[0]=stale?1:0;
+      state.reserve()[0]=static_cast<uint32_t>(std::llround(data->time*1000.));
+      // Explicitly marked simulated contact-force proxy, not calibrated hardware pressure.
+      state.reserve()[1]=0x44583343;
+      for (std::size_t i=0;i<7;++i) {
+        const int joint=hand.joint[i];
+        const double desired=std::clamp(target[i],model->jnt_range[2*joint],model->jnt_range[2*joint+1]);
+        hand.reference[i]+=std::clamp(desired-hand.reference[i],-1.5*model->opt.timestep,1.5*model->opt.timestep);
+        const double q=data->qpos[hand.qpos[i]],dq=data->qvel[hand.dof[i]];
+        const double limit=i==0?2.45:1.4;
+        hand.effort[i]=std::clamp(kp[i]*(hand.reference[i]-q)+kd[i]*(velocity[i]-dq)+tau[i],-limit,limit);
+        data->qfrc_applied[hand.dof[i]]=hand.effort[i];
+        state.motor_state()[i].q()=q;state.motor_state()[i].dq()=dq;
+        state.motor_state()[i].tau_est()=hand.effort[i];
+      }
+      if (!publish) {continue;}
+      const std::string prefix=(side==0?"left":"right")+std::string("_hand_");
+      for (int c=0;c<data->ncon;++c) {
+        const auto &contact=data->contact[c];
+        const int a=model->geom_bodyid[contact.geom1],b=model->geom_bodyid[contact.geom2];
+        if (model->body_rootid[a]==model->body_rootid[b]) {continue;}
+        for (int body : {a,b}) {
+          const char *raw=mj_id2name(model,mjOBJ_BODY,body);
+          if (!raw) {continue;}
+          const std::string name(raw);
+          if (name.rfind(prefix,0)!=0) {continue;}
+          int sensor=-1;
+          for (std::size_t i=0;i<7;++i) {
+            if (name==prefix+names_[i]+"_link") {sensor=i<3?i:(i<5?i:i+1);break;}
+          }
+          if (sensor<0) {continue;}
+          mjtNum force[6];mj_contactForce(model,data,c,force);
+          state.press_sensor_state()[sensor].pressure()[0]+=std::max<mjtNum>(0.,force[0]);
+        }
+      }
+      hand.publisher->Write(state);
+    }
+  }
+};
+}
diff --git a/simulate/test/dex3_contact_bench.cc b/simulate/test/dex3_contact_bench.cc
new file mode 100644
index 0000000..8f0b2a5
--- /dev/null
+++ b/simulate/test/dex3_contact_bench.cc
@@ -0,0 +1,65 @@
+#include "dex3_hand.h"
+#include <chrono>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <limits>
+#include <thread>
+
+// Standalone mechanical wrist rig driven through the actual Dex3 DDS backend.
+// Only the wrist slide actuators move; the object has no constraints or forces.
+int main(int argc,char **argv) {
+  if (argc!=3) {return 2;}
+  const char *domain=std::getenv("ROS_DOMAIN_ID");
+  unitree::robot::ChannelFactory::Instance()->Init(domain?std::atoi(domain):91,"lo");
+  char error[2048]{};
+  mjModel *model=mj_loadXML(argv[1],nullptr,error,sizeof(error));
+  if (!model) {std::cerr<<error<<std::endl;return 2;}
+  if (model->neq!=0 || model->nu!=2) {return 2;}
+  mjData *data=mj_makeData(model);
+  const int object=mj_name2id(model,mjOBJ_BODY,"object");
+  if (object<0) {return 2;}
+  unitree_mujoco::Dex3Hands hands;
+  const auto start=std::chrono::steady_clock::now();
+  double min_lift=std::numeric_limits<double>::infinity();
+  bool opposed=true,object_forces=false,final_contact=false;
+  int held_samples=0;
+  // Include the complete bounded six-second slow-opening service window.
+  for (int step=0;step<9000;++step) {
+    const double t=data->time;
+    data->ctrl[0]=.04*std::min(1.,t);
+    data->ctrl[1]=t<9.?std::min(.15,std::max(0.,(t-5.)*.075)):std::max(0.,.15-(t-9.)*.075);
+    hands.Update(model,data);
+    mj_step(model,data);
+    const int dof=model->jnt_dofadr[model->body_jntadr[object]];
+    for (int i=0;i<6;++i) {object_forces|=data->qfrc_applied[dof+i]!=0 || data->xfrc_applied[6*object+i]!=0;}
+    bool thumb=false,finger=false;
+    for (int c=0;c<data->ncon;++c) {
+      const auto &contact=data->contact[c];
+      const int a=model->geom_bodyid[contact.geom1],b=model->geom_bodyid[contact.geom2];
+      if (a!=object && b!=object) {continue;}
+      const char *name=mj_id2name(model,mjOBJ_BODY,a==object?b:a);
+      mjtNum force[6];mj_contactForce(model,data,c,force);
+      if (!name || force[0]<.05) {continue;}
+      const std::string link(name);
+      thumb|=link.find("hand_thumb")!=std::string::npos;
+      finger|=link.find("hand_index")!=std::string::npos || link.find("hand_middle")!=std::string::npos;
+    }
+    if (t>=7.2 && t<=8.8) {
+      min_lift=std::min(min_lift,data->xpos[3*object+2]-1.);
+      opposed&=thumb&&finger;
+      ++held_samples;
+    }
+    final_contact=thumb||finger;
+    std::this_thread::sleep_until(start+std::chrono::microseconds(static_cast<long long>(data->time*1e6)));
+  }
+  const double final_z=data->xpos[3*object+2];
+  const bool success=held_samples>700 && min_lift>.1 && opposed && !object_forces && !final_contact && std::abs(final_z-1.)<.025;
+  std::ofstream output(argv[2]);
+  output<<std::boolalpha<<"{\"success\":"<<success<<",\"minimum_held_lift_m\":"<<min_lift
+        <<",\"opposed_contacts\":"<<opposed<<",\"object_external_force\":"<<object_forces
+        <<",\"object_constraints\":0,\"released\":"<<!final_contact<<",\"final_z\":"<<final_z
+        <<",\"elapsed_s\":"<<data->time<<",\"scope\":\"DDS-controlled contact-only wrist rig\"}\n";
+  mj_deleteData(data);mj_deleteModel(model);
+  return success?0:1;
+}
diff --git a/simulate/src/command_application_timing.h b/simulate/src/command_application_timing.h
new file mode 100644
index 0000000..65902f6
--- /dev/null
+++ b/simulate/src/command_application_timing.h
@@ -0,0 +1,33 @@
+#pragma once
+#include <cstdint>
+
+namespace unitree_mujoco {
+struct CommandApplicationSample {
+  std::uint64_t sequence = 0;
+  std::uint32_t crc = 0;
+  std::int64_t received_ns = 0;
+  std::int64_t applied_ns = 0;
+  std::uint32_t tick_ms = 0;
+};
+
+// Called only after a usable command has actually filled the physics controls.
+// Repeated physics steps holding that command are not new applications.
+class CommandApplicationTiming {
+ public:
+  bool Record(std::uint64_t sequence, std::uint32_t crc, std::int64_t received_ns,
+              std::int64_t applied_ns, std::uint32_t tick_ms) {
+    if (sequence <= latest_.sequence || received_ns <= 0 || applied_ns < received_ns) {
+      return false;
+    }
+    const bool changed = latest_.sequence == 0 || latest_.crc != crc;
+    latest_ = {sequence, crc, received_ns, applied_ns, tick_ms};
+    if (changed) transition_ = latest_;
+    return true;
+  }
+  const CommandApplicationSample& latest() const { return latest_; }
+  const CommandApplicationSample& latest_transition() const { return transition_; }
+ private:
+  CommandApplicationSample latest_;
+  CommandApplicationSample transition_;
+};
+}  // namespace unitree_mujoco
diff --git a/simulate/test/command_application_timing_test.cc b/simulate/test/command_application_timing_test.cc
new file mode 100644
index 0000000..1c2b10d
--- /dev/null
+++ b/simulate/test/command_application_timing_test.cc
@@ -0,0 +1,19 @@
+#include "command_application_timing.h"
+#include <cstdlib>
+
+int main() {
+  unitree_mujoco::CommandApplicationTiming timing;
+  if (timing.Record(0, 7, 100, 102, 2)) return EXIT_FAILURE;
+  if (!timing.Record(1, 7, 100, 102, 2)) return EXIT_FAILURE;
+  if (timing.Record(1, 7, 100, 110, 10)) return EXIT_FAILURE;
+  if (timing.latest().applied_ns != 102) return EXIT_FAILURE;
+  // Identical wire content can be a distinct DDS command. Never merge by CRC.
+  if (!timing.Record(2, 7, 110, 113, 12)) return EXIT_FAILURE;
+  if (timing.latest_transition().sequence != 1) return EXIT_FAILURE;
+  if (timing.Record(1, 8, 110, 113, 12)) return EXIT_FAILURE;
+  if (timing.Record(3, 9, 120, 119, 14)) return EXIT_FAILURE;
+  if (timing.latest().sequence != 2 || timing.latest().received_ns != 110) return EXIT_FAILURE;
+  if (!timing.Record(3, 8, 120, 122, 14)) return EXIT_FAILURE;
+  if (timing.latest_transition().applied_ns != 122) return EXIT_FAILURE;
+  return EXIT_SUCCESS;
+}
